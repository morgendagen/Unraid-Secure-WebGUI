?>

<script type="module">
    import { ACME } from '/plugins/ACME/js/ACME.js?11'
    var acme = new ACME();
    acme.setCurrentEnvironment(<?=json_encode($savedEnvironment)?>);
    acme.setCurrentDnsProvider("<?=$currentDnsApi?>");
    window.acme = acme;
</script>

