<?php
require("/usr/local/emhttp/plugins/ACME/include/ACME.php");

$acme = new ACME();
$cert1URL = $acme->getCertificateDomain() ?? '';
$cert1File = $acme->getCertificateFile() ?? '';

// Secrets are replaced by ACME::SECRET_PLACEHOLDER, never send the actual values.
$savedEnvironment = $acme->getSavedEnvironment($cert1URL);
$currentDnsApi = $acme->getDnsApi($cert1URL);
$verboseLogging = $acme->isVerboseLoggingEnabled();
?>

<script type="module">
    import { ACME } from '/plugins/ACME/js/ACME.js?13'
    var acme = new ACME();
    acme.setSecretOptions(<?=json_encode(ACME::SECRET_PATTERN, JSON_HEX_TAG|JSON_HEX_AMP)?>, <?=json_encode(ACME::SECRET_PLACEHOLDER, JSON_HEX_TAG|JSON_HEX_AMP)?>);
    acme.setCurrentEnvironment(<?=json_encode((object)$savedEnvironment, JSON_HEX_TAG|JSON_HEX_AMP)?>);
    acme.setCurrentDnsProvider(<?=json_encode($currentDnsApi, JSON_HEX_TAG|JSON_HEX_AMP)?>);
    window.acme = acme;
</script>

<p>
Before proceeding, make sure you have configured a valid local TLD in
<a href="/Settings/ManagementAccess">Management Access</a>.

Once you have a valid certificate, head back to <a href="/Settings/ManagementAccess">Management Access</a>
and enable "Use SSL/TLS".
</p>
