<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
    <!ENTITY name        "ACME">
    <!ENTITY author      "morgendagen">
    <!ENTITY version     "2026.11.10">
    <!ENTITY md5         "6829d84ed4b03af637f49d92487f2139">
    <!ENTITY githubURL   "https://raw.githubusercontent.com/morgendagen/Unraid-Secure-WebGUI">
    <!ENTITY pluginURL   "&githubURL;/main/ACME.plg">
    <!ENTITY plugin      "/boot/config/plugins/&name;">
    <!ENTITY emhttp      "/usr/local/emhttp/plugins/&name;">
    <!ENTITY supportURL  "https://forums.unraid.net/topic/189395-plugin-secure-unraid-webgui-with-acmesh/">
]>

<PLUGIN
    name="&name;"
    author="&author;"
    version="&version;"
    pluginURL="&pluginURL;"
    support="&supportURL;"
>

<CHANGES>
###2026.11.10
- The "Certificate renewed" notification is now shown when issuing a certificate from the WebGUI.
- Failing to install a certificate or reload the WebGUI now posts an alert notification, also for automatic renewals. The certificate file is replaced only once it has been written completely.
- Certificates from the staging server are no longer installed, as browsers don't trust them. The page shows a notice while the current certificate is from the staging server, until a certificate is issued without staging.
- Switching between the staging and production servers now always issues a new certificate.
- Issuing while the certificate is still valid is now reported as skipped instead of failed. Changed DNS provider settings are only checked and saved when a certificate is issued; use "Force certificate renewal" to issue one now.
- Only the options of the selected DNS provider are accepted, and web request data is no longer passed on to acme.sh.
- The ZeroSSL registration email address is validated.

###2026.11.08
- Saved DNS provider secrets (passwords, tokens, keys) are no longer sent to the browser. They are shown as ***PASSWORD***; leave unchanged to keep, change to replace, or clear the field to remove the saved value.
- Clearing a DNS provider option now removes its saved value, so it is no longer used for renewals.
- Options saved per domain by some DNS providers (e.g. Cloudflare with a Zone ID) are now shown.
- DNS provider credentials containing special characters such as $ or # are no longer altered.
- DNS provider credentials are no longer visible in the process list while issuing.
- Validate input used to run acme.sh, and escape values shown in the web UI.

###2026.11.07
- Added "Verbose logging" option for troubleshooting. Shows acme.sh debug output when issuing a certificate, and logs automatic renewals to the System Log.
- Errors from automatic renewals are now logged to the System Log.
- Verbose logging shows the acme.sh command being run, with DNS provider credentials hidden.
- Popup title shows whether the operation is working, completed or failed.
- Failed certificate issuing and ZeroSSL registration are no longer reported as successful.

###2026.08.14
- Non-shared options must be optional when there are alternative options.

###2026.06.24a
- Fixed issue downloading the new dnsapi_info.txt file due to caching.

###2026.06.24
- Fixed issue where modified .js files were not being loaded correctly due to caching.

###2026.06.23
- Updated acme.sh to version 3.1.3.
- Add support for alternative options.

###2025.04.22
- Disclaimer clarification.

###2025.04.20
- Initial release.
</CHANGES>

<FILE Name="&plugin;/&name;-&version;-noarch-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>&githubURL;/main/archive/&name;-&version;-noarch-1.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- Remove old plugin packages -->
<FILE Run="/bin/bash">
<INLINE>
rm -f $(ls &plugin;/&name;*.txz 2>/dev/null|grep -v '&version;')
</INLINE>
</FILE>

<!-- The 'post-install' script. -->
<FILE Run="/bin/bash">
<INLINE>
chmod a+x /usr/share/&name;/scripts/*
/usr/share/&name;/acme.sh/acme.sh --config-home &plugin; --home /usr/share/ACME/acme.sh --install-cronjob
echo ""
echo "-----------------------------------------------------------"
echo " Unraid-Secure-WebGUI has been installed."
echo " Copyright 2025, Peder Toftegaard Olsen &lt;peder@morgendagen.dk&gt;"
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "+=============================================================================="
echo "| Uninstalling cron job"
echo "+=============================================================================="

/usr/share/ACME/acme.sh/acme.sh --config-home &plugin; --home /usr/share/&name;/acme.sh --uninstall-cronjob

echo "+=============================================================================="
echo "| Removing &plugin; package"
echo "+=============================================================================="

removepkg &name;-&version;-noarch-1

echo "+=============================================================================="
echo "| Deleting &plugin;"
echo "+=============================================================================="

# Remove plugin.
rm -rf &plugin;

echo "+=============================================================================="
echo "| Deleting &emhttp;"
echo "+=============================================================================="

# Remove plugin.
rm -rf &emhttp;

echo "+=============================================================================="
echo "| Deleting /usr/share/ACME"
echo "+=============================================================================="

rm -rf /usr/share/ACME

echo ""
echo ""
</INLINE>
</FILE>

</PLUGIN>
